{
  "expo": {
    "name": "Moments",
    "slug": "moments",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "bundleIdentifier": "com.sasidhar8785.moments",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Moments connects to the Moments server on your computer to generate your videos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#121110",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.sasidhar8785.moments"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Moments uses the camera to film your scene.",
          "microphonePermission": "Moments records sound with your scene.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Moments saves your finished moments to Photos.",
          "savePhotosPermission": "Moments saves your finished moments to Photos.",
          "granularPermissions": [
            "video"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo to use as your character."
        }
      ],
      "expo-video",
      "expo-sharing",
      "expo-image",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "scheme": "moments",
    "backgroundColor": "#121110",
    "experiments": {
      "typedRoutes": true
    }
  }
}
